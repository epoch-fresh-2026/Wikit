# Export these into the process environment; dotenv files are not loaded.
WIKIT_PUBLIC_URL=http://localhost:8080
WIKIT_DATABASE_URL=postgres://wikit:local_only@localhost:5432/wikit?sslmode=disable
WIKIT_MEDIA_ROOT=.local/media
WIKIT_LISTEN_ADDR=:8080
WIKIT_REGISTRATION_ENABLED=true
WIKIT_SESSION_TTL=24h
WIKIT_MAX_UPLOAD_BYTES=104857600
WIKIT_BLOB_GC_GRACE=168h
WIKIT_MEILI_URL=http://localhost:7700
# Set a private Meilisearch API key through the process environment.
WIKIT_MEILI_KEY=
