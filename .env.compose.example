# Build locally; after a release, pin its published version/digest here.
WIKIT_IMAGE=wikit:local
WIKIT_PUBLIC_URL=http://localhost:8080
WIKIT_BIND=127.0.0.1
WIKIT_PORT=8080
# Replace these; URL password must be URL-safe (for example random hex).
POSTGRES_PASSWORD=replace_with_random_hex
WIKIT_DATABASE_PASSWORD=replace_with_different_random_hex
WIKIT_MEILI_KEY=replace_with_at_least_16_random_bytes
